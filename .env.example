# ==============================================================================
# All-Local Live Stream AI Co-Host Pipeline Configuration
# Running solely on the OBS Host Machine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OBS Studio WebSocket (Tools -> WebSocket Server Settings in OBS)
# ------------------------------------------------------------------------------
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
OBS_TRANSCRIPT_SOURCE="Guest Transcript"
OBS_STREAM_POLL_INTERVAL=2.0
OBS_CELEBRATE_SOURCE="Celebration FX"
OBS_CELEBRATE_DURATION=5.0
OBS_CELEBRATE_FILTER=

# Optional path to a live transcript text/SRT file (e.g. LocalVocal / Whisper)
TRANSCRIPT_FILE_PATH=

# ------------------------------------------------------------------------------
# 2. Streamer Identity & YouTube Live Stream
# ------------------------------------------------------------------------------
HOST_STREAMER_NAME=Massive
HOST_STREAMER_HANDLE=@MassiveGodComplex
YOUTUBE_CHANNEL_HANDLE=@MassiveGodComplex
CHANNEL_HANDLES=MassiveGodComplex,Bradford,Brad
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY
YOUTUBE_VIDEO_ID=
VIEWER_POLL_INTERVAL=20.0
# Polling interval (seconds) specifically when there are 0 concurrent viewers to catch new arrivals faster
VIEWER_0_POLL_INTERVAL=5.0
CHAT_POLL_INTERVAL=0.5
AUTO_TRACK_LIVE_VIEWERS=true


# ------------------------------------------------------------------------------
# 3. Google Gemini API & AI Co-Host Persona
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Gemini 3.7 Flash: high performance multimodal model with ultra-low latency streaming
GEMINI_MODEL=gemini-3.7-flash
# Thinking controls for Gemini 3.7 Flash (budget: 128 for minimal reasoning buffer with sub-second TTFT)
GEMINI_THINKING_BUDGET=128
GEMINI_THINKING_LEVEL=LOW
# Generation knobs (1024 max tokens provides abundant headroom for thinking tokens + 1-2 sentence spoken output (~5-50 words); temp 0.7 & top_p 0.9 keep voice creative)
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.9
AI_COHOST_NAME=I Am
TRIGGER_WORDS=i am,iam,ai,cohost,hey i am,what do you think,bot,roast,who is better,nova,massivegodcomplex,god complex
MIN_INTERJECTION_INTERVAL_SEC=5.0
IGNORE_PEER_REPLIES=true
GREET_NEW_CHATTERS=true
GREET_VIEWER_JOINS=false
CHAT_ENCOURAGEMENT_ENABLED=false
CHAT_ENCOURAGEMENT_INTERVAL_SEC=300.0
THANK_SUBSCRIBERS=true

# ------------------------------------------------------------------------------
# 4. Token Efficiency & Engagement State Controls
# ------------------------------------------------------------------------------
OBS_REQUIRE_STREAM_ACTIVE=true
MIN_CONCURRENT_VIEWERS_ACTIVE=1
CHAT_IDLE_TIMEOUT_SEC=120.0
ECO_MODE_ENABLED=true
MAX_RESPONSES_PER_MINUTE=6
MAX_RESPONSES_PER_HOUR=80

# Spontaneous extended spiritual commentary during quiet stream/chat periods
SPONTANEOUS_COMMENTARY_ENABLED=true
IDLE_SILENCE_THRESHOLD_SEC=45.0
SPONTANEOUS_MIN_INTERVAL_SEC=60.0
SPONTANEOUS_MAX_BACKOFF_SEC=600.0
MOTTO_PHRASE=Everything is perfect.
# Configurable time delay (seconds) before motto starts fading in after speech/comments dissolve
MOTTO_PRE_FADE_IN_SEC=2.0
MOTTO_FADE_IN_SEC=1.4
MOTTO_FADE_OUT_SEC=0.6

# Post-speech hold and transition timings
COMMENT_POST_SPEECH_HOLD_SEC=15.0
COMMENT_ACTIVE_QUEUE_HOLD_SEC=2.5
# Configurable seconds to wait after a reflection ends when a chat question is the next item to process
REFLECTION_POST_SPEECH_CHAT_DELAY_SEC=3.0

# Set to true to read/speak every single chat message aloud (Chat Reader Mode - 0 LLM tokens)
CHAT_READER_MODE=false

# ------------------------------------------------------------------------------
# 5. Neural TTS Settings (Dual-Backend: ChatterBox Turbo on LAN / Edge-TTS Failback)
# ------------------------------------------------------------------------------
# Primary backend: 'chatterbox' (GPU inference server on LAN) or 'edge' (local Edge-TTS)
TTS_BACKEND=chatterbox
# ChatterBox Turbo inference server endpoint on LAN (GAMER @ 192.168.0.115)
TTS_SERVER_URL=http://192.168.0.115:8123
# Reference voice audio clip located in C:\Services\tts-server\voices\ on GAMER
TTS_REFERENCE_VOICE=cohost.wav
TTS_REQUEST_TIMEOUT_FLOOR=5.0
TTS_REQUEST_TIMEOUT_CEILING=30.0
TTS_EXAGGERATION_DEFAULT=0.5

# Edge-TTS Local Fallback Settings (used when TTS_BACKEND=edge or on chatterbox failover)
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-ChristopherNeural
TTS_SAMPLE_RATE=48000
TTS_PITCH=+0Hz
TTS_RATE=+5%

# ------------------------------------------------------------------------------
# 6. Visualizer & NDI Engine (Supports 16:9 1920x1080 and 9:16 1080x1920)
# ------------------------------------------------------------------------------
VISUALIZER_ASPECT_RATIO=16:9
VISUALIZER_WIDTH=1920
VISUALIZER_HEIGHT=1080
VISUALIZER_FPS=60
VISUALIZER_HEADLESS=false
SHOW_TOP_STATUS_BAR=false
SHOW_HOST_TRANSCRIPT_CARD=false
PROMO_OVERLAY_ENABLED=true
PROMO_OVERLAY_INTERVAL_SEC=75.0
PROMO_OVERLAY_DURATION_SEC=10.0
# ------------------------------------------------------------------------------
# 7. Windows Audio Output (OBS Window Capture 'Capture Audio' / Application Audio Capture)
# ------------------------------------------------------------------------------
LOCAL_AUDIO_ENABLED=true
LOCAL_AUDIO_VOLUME=1.0
LOCAL_AUDIO_DEVICE=
# Audio buffer latency: 'high' (recommended for OBS host under heavy encoding load), 'standard', or 'low'
LOCAL_AUDIO_LATENCY=high
# Process priority allocation on Windows: 'above_normal' (recommended) or 'high'
PROCESS_PRIORITY=above_normal

# ------------------------------------------------------------------------------
# 8. NDI Broadcast Engine (OBS NDI Source / DistroAV)
# ------------------------------------------------------------------------------
NDI_STREAM_NAME=AI_COHOST_FEED

# ------------------------------------------------------------------------------
# 9. The Cast Subsystem (Synthetic Asker Archetypes)
# ------------------------------------------------------------------------------
CAST_ENABLED=true
# When true, pauses synthetic cast questions while in ECO MODE (0 viewers / quiet stream) until viewers arrive.
CAST_REQUIRE_VIEWERS=true
CAST_MIN_INTERVAL_SEC=75.0
CAST_MAX_INTERVAL_SEC=160.0
CAST_QUIET_CHAT_THRESHOLD_SEC=45.0
CAST_MAX_PER_SESSION=50

# ------------------------------------------------------------------------------
# 10. Pre-Computed Caches (Zero Latency Streaming)
# ------------------------------------------------------------------------------
# Pre-computed spontaneous cosmic reflections (0.0s TTFT)
REFLECTION_CACHE_ENABLED=true
REFLECTION_CACHE_SIZE=4

# Pre-synthesized welcome greetings with 48kHz audio buffer (<5ms instant speech on viewer 0 -> 1+ arrival)
GREETING_CACHE_ENABLED=true
GREETING_CACHE_SIZE=3
GREETING_CACHE_POLL_INTERVAL_SEC=15.0
